# =========================================================
# EditalFinder Frontend — Environment Example
# =========================================================
# Copie este arquivo para .env.local ou .env
# Nunca commite .env real com chaves/URLs privadas.
#
# Vite só expõe variáveis que começam com VITE_.
# NÃO usar service_role key no frontend.
# Use apenas a anon/public key do Supabase.
# =========================================================

# Ambiente
VITE_APP_ENV=local

# URLs públicas (confirmação de e-mail — obrigatório em produção/staging)
VITE_PUBLIC_SITE_URL=http://localhost:5173/editalfinder
VITE_AUTH_CALLBACK_URL=http://localhost:5173/editalfinder/auth/callback

# --- App desktop (Tauri) — npm run desktop:dev / desktop:build ---
# Use as mesmas chaves VITE_SUPABASE_* (apenas anon key; nunca service_role).
# Em desktop:dev o Vite sobe em http://localhost:5173/ (sem /editalfinder):
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# VITE_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
# No build instalado, adicione no Supabase Auth → Redirect URLs a origem exibida
# pela janela (ex.: https://tauri.localhost) + /auth/callback — veja docs/DESKTOP_APP_WINDOWS.md
# Produção (exemplo — ajustar domínio):
# VITE_PUBLIC_SITE_URL=https://seudominio.com/editalfinder
# VITE_AUTH_CALLBACK_URL=https://seudominio.com/editalfinder/auth/callback

# Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_SUPABASE_ANON_KEY

# Views principais
VITE_VIEW_EDITAIS=vw_editais_front
VITE_VIEW_NOTICIAS=vw_noticias_front
VITE_VIEW_PESQUISAS=vw_pesquisas_front
VITE_VIEW_FORNECEDORES=vw_fornecedores_front
VITE_VIEW_INVESTIMENTOS=vw_investimentos_front

# Concursos & Seleções (views Supabase)
VITE_VIEW_CONCURSOS=vw_concursos_front
VITE_VIEW_VESTIBULARES=vw_vestibulares_front
VITE_ENABLE_CONCURSOS=true

# Flags de funcionalidades
VITE_ENABLE_PORTAIS_ESTRATEGICOS=true
VITE_ENABLE_FORNECEDORES=true
VITE_ENABLE_INVESTIMENTOS=true
VITE_ENABLE_RADAR=true
# Favoritos de editais + alertas de prazo (Supabase: tabela edital_favorito + view vw_editais_favoritos_front)
VITE_VIEW_EDITAIS_FAVORITOS=vw_editais_favoritos_front
VITE_TABLE_EDITAL_FAVORITO=edital_favorito
VITE_ENABLE_EDITAL_FAVORITOS=true
# Opcional (só desenvolvimento): id_usuario usado em favoritos remotos quando o utilizador em sessão não tem id_usuario (ex.: sessão antiga). Default 1.
# VITE_DEV_FAVORITOS_USER_ID=1
VITE_ENABLE_DEBUG_PIPELINE=false
# Mostrar rota /indice no menu (default: oculto — a rota continua acessível por URL direta)
# VITE_ENABLE_INDICE=true

# Workspace do Consultor (rota /workspace-consultor, menu Workspaces)
VITE_ENABLE_CONSULTOR_WORKSPACE=true

# Reporte de problemas em editais (MVP: INSERT em public.edital_feedback via Supabase client)
# Opcional: POST para Edge Function (tem prioridade se definido)
# VITE_EDITAL_FEEDBACK_ENDPOINT=https://SEU-PROJETO.supabase.co/functions/v1/report-edital-feedback
# VITE_EDITAL_FEEDBACK_MOCK_DEV=true
VITE_SUPPORT_EMAIL=editalfinder@gmail.com

# Nome da aplicação
VITE_APP_NAME=EditalFinder
# Versão na UI: definida no build a partir de src-tauri/tauri.conf.json (não precisa setar aqui)
# VITE_APP_VERSION=0.1.0

# IA científica (somente backend/Edge — nunca chave OpenAI no Vite)
VITE_ENABLE_SCIENTIFIC_AI=false

# Alias documentado (o código usa VITE_ENABLE_RADAR)
VITE_ENABLE_RADAR_FOMENTO=true