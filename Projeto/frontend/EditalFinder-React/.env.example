# =========================================================
# EditalFinder Frontend — Environment Example
# =========================================================
# Copie este arquivo para .env.local ou .env
# Nunca commite .env real com chaves/URLs privadas.
#
# Vite só expõe variáveis que começam com VITE_.
# NÃO usar service_role key no frontend.
# Use apenas a anon/public key do Supabase.
# =========================================================

# Ambiente
VITE_APP_ENV=local

# Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_SUPABASE_ANON_KEY

# Views principais
VITE_VIEW_EDITAIS=vw_editais_front
VITE_VIEW_NOTICIAS=vw_noticias_front
VITE_VIEW_PESQUISAS=vw_pesquisas_front
VITE_VIEW_FORNECEDORES=vw_fornecedores_front
VITE_VIEW_INVESTIMENTOS=vw_investimentos_front

# Flags de funcionalidades
VITE_ENABLE_PORTAIS_ESTRATEGICOS=true
VITE_ENABLE_FORNECEDORES=true
VITE_ENABLE_INVESTIMENTOS=true
VITE_ENABLE_RADAR=true
# Favoritos de editais + alertas de prazo (Supabase: tabela edital_favorito + view vw_editais_favoritos_front)
VITE_VIEW_EDITAIS_FAVORITOS=vw_editais_favoritos_front
VITE_TABLE_EDITAL_FAVORITO=edital_favorito
VITE_ENABLE_EDITAL_FAVORITOS=true
# Opcional (só desenvolvimento): id_usuario usado em favoritos remotos quando o utilizador em sessão não tem id_usuario (ex.: sessão antiga). Default 1.
# VITE_DEV_FAVORITOS_USER_ID=1
VITE_ENABLE_DEBUG_PIPELINE=false
# Mostrar rota /indice no menu (default: oculto — a rota continua acessível por URL direta)
# VITE_ENABLE_INDICE=true

# Nome da aplicação
VITE_APP_NAME=EditalFinder