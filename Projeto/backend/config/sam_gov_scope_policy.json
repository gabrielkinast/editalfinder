  ],
  "preferred_notice_types_substrings": [
    "solicitation",
    "sources sought",
    "presolicitation",
    "special notice",
    "combined synopsis",
    "broad agency",
    "baa",
    "rfi",
    "rfp",
    "intent to bundle"
  ],
  "acceptance_rules": {
    "require_notice_detail_link": true,
    "require_non_empty_title": true,
    "require_agency_or_department": true,
    "require_min_positive_hits": 1,
    "reject_if_strong_negative_dominant": true,
    "strong_negative_dominant_min_neg": 2,
    "reject_search_or_listing_url": true,
    "reject_url_substrings": [
      "/search/",
      "content/home",
      "content/opportunities"
    ],
    "min_relevance_to_save": "medium_relevance"
  },
  "relevance_scoring": {
    "high_relevance": {
      "min_positive_hits": 2,
      "or_agency_priority_match": true
    },
    "medium_relevance": {
      "min_positive_hits": 1,
      "or_notice_type_preferred": true
    },
    "low_relevance": {
      "min_positive_hits": 1
    },
    "reject_noise": {
      "negative_hits_gte": 2,
      "positive_hits_eq": 0
    }
  },
  "collection": {
    "max_items_output": 25,
    "max_distinct_api_calls": 8,
    "per_request_limit": 8,
    "posted_days_back": 300,
    "request_delay_seconds": 1.35,
    "http_timeout_seconds": 45,
    "api_base_urls": [
      "https://api.sam.gov/prod/opportunities/v2/search",
      "https://api.sam.gov/opportunities/v2/search"
    ],
    "title_search_queries": [
      "research",
      "SBIR",
      "prototype",
      "nuclear",
      "aerospace",
      "DARPA",
      "quantum",
      "energy"
    ],
    "optional_ptypes": ["o", "p", "r", "k", "s"]
  },
  "official_link_only_default": false,
  "notes": [
    "API pública GSA requer SAM_GOV_API_KEY (chave pública da conta SAM.gov, não é segredo de aplicação interna).",
    "Sem chave: o crawler não grava fallback de listagem; output pode ser vazio.",
    "official_link_only permanece desativado para sam_gov em official_link_only.py até decisão explícita."
  ]
}
